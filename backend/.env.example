# ---- General ----
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=20
DATABASE_PATH=./data/truthchain.db

# ---- Auth ----
# dev  = every request is user "dev-user" (LOCAL TESTING ONLY, never deploy with this)
# supabase = require "Authorization: Bearer <Supabase access token>"
AUTH_MODE=dev
SUPABASE_JWT_SECRET=PASTE_JWT_SECRET_FROM_SUPABASE_PROJECT_SETTINGS

# ---- AI detector ----
# demo = returns a clearly labeled DEMO score (NOT a real detection)
# real = runs the Hugging Face model named in MODEL_ID
DETECTOR_MODE=demo
# Choose only after reading the model card: license, input size, evaluation, limits.
MODEL_ID=
MODEL_VERSION=unversioned
# Name of the label that means "AI-generated" in that model (check the model card).
AI_LABEL=
# Optional Platt calibration file: {"a": 4.2, "b": -2.1, "version": "cal-2026-01"}
CALIBRATION_FILE=

# ---- Blockchain (leave empty to run without registration) ----
AMOY_RPC_URL=https://YOUR_PROVIDER_AMOY_RPC
CHAIN_ID=80002
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT
CONTRACT_ABI_PATH=../blockchain/artifacts/contracts/TruthChainRegistry.sol/TruthChainRegistry.json
EXPLORER_BASE_URL=https://amoy.polygonscan.com
# Server-only secret. Never commit a real key.
REGISTRAR_PRIVATE_KEY=DO_NOT_COMMIT_REAL_KEY
